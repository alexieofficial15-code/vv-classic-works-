# =================================================================
# Classic Aircooled VW Works - Backend Environment Variables
# Copy this file to .env for local development or enter into Render Dashboard
# =================================================================

# Server Port (Render sets this automatically to 10000)
PORT=5000

# Authentication Security Secret (Must be >= 32 characters)
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars_here

# Master Admin Credentials (Hash generated via: node backend/scripts/hash-password.js <password>)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD_HASH=$2b$10$exampleBcryptHashGeneratedByScript
ADMIN_SECRET_KEY=optional_secret_key_here

# Frontend Production Origin (comma-separated list for Vercel and custom domain)
CLIENT_ORIGIN=https://your-frontend-app.vercel.app,https://www.yourdomain.com

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_ANON_KEY=eyJhbGciOi...

# (Optional) SMTP Email Notifications (Gmail / Outlook / SendGrid / Brevo)
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SERVICE=gmail
EMAIL_FROM=support@classicaircooledvw.com
