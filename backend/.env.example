# =================================================================
# Classic Aircooled VW Works - Backend Environment Variables
# Copy this file to .env for local development or enter into Render Dashboard
# =================================================================

# Server Port (Render sets this automatically to 10000)
PORT=5000

# Authentication Security Secret (REQUIRED: random string, e.g. `openssl rand -hex 48`)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Production URL(s), comma-separated. If unset, CORS is open to all origins.
CLIENT_ORIGIN=https://www.classicaircooledvwworks.com

# Master Admin Credentials (REQUIRED for admin login; there are no built-in defaults)
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_ANON_KEY=eyJhbGciOi...

# (Optional) SMTP Email Notifications (Gmail / Outlook / SendGrid / Brevo)
# If left blank, email notifications are safely simulated in the server logs
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SERVICE=gmail
EMAIL_FROM=support@classicaircooledvw.com

