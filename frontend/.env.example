# Classic Aircooled VW Works Frontend Environment Variables
VITE_API_URL=https://vv-classic-works.onrender.com

# Optional analytics (see src/analytics.js)
# GA4 measurement ID, enables GA4 ecommerce events
VITE_GA4_ID=
# Dedicated Google Ads conversion labels ("AW-18481077913/xxxx"). If unset, the existing
# Add-to-cart label is reused for purchases and leads.
VITE_ADS_LABEL_PURCHASE=
VITE_ADS_LABEL_LEAD=
VITE_ADS_LABEL_CALL=
