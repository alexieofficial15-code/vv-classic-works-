# =================================================================
# Classic Aircooled VW Works Frontend Environment Variables
# =================================================================

# Backend REST API Base URL
VITE_API_URL=https://vv-classic-works.onrender.com

# Google Ads Primary Purchase Conversion Label (Tag: AW-18481077913)
# Paste your Purchase conversion label from Google Ads below.
# Accepts either the label suffix (e.g. AbCdEfGhIjK) or full send_to (e.g. AW-18481077913/AbCdEfGhIjK).
VITE_GADS_PURCHASE_LABEL=REPLACE_WITH_PURCHASE_LABEL

# Optional Google Ads Conversion Labels
# Secondary Add to Cart label (defaults to _W70CKWVyIsdEJm9u-xE)
VITE_GADS_ADD_TO_CART_LABEL=_W70CKWVyIsdEJm9u-xE
# Reservation & Parts Request Lead label (optional)
VITE_GADS_LEAD_LABEL=
# Phone Tap Call label (optional)
VITE_ADS_LABEL_CALL=
# WhatsApp click label (optional)
VITE_ADS_LABEL_WHATSAPP=
# Chat "message sent" label (optional, fires only after the server accepts the message)
VITE_ADS_LABEL_MESSAGE=

# Optional Google Analytics 4 Measurement ID (Format: "G-XXXXXXXXXX")
VITE_GA4_ID=

# Contact Details (Configured in Vercel)
# WhatsApp contact number (digits only, e.g. 19452879865)
VITE_WHATSAPP_NUMBER=your_whatsapp_number_here

# Public support email shown on the Contact, Privacy, Returns and Terms pages (hidden until set)
VITE_SUPPORT_EMAIL=

# Facebook Page URL
VITE_FACEBOOK_URL=https://www.facebook.com/your_page_here

# Facebook Messenger URL
VITE_FACEBOOK_MESSENGER_URL=https://m.me/your_page_here
