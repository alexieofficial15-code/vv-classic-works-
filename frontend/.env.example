# =================================================================
# Classic Aircooled VW Works Frontend Environment Variables (Vercel)
# =================================================================

# Backend REST API Base URL
VITE_API_URL=https://vv-classic-works.onrender.com

# Google Ads Conversion Labels (Format: "AW-18481077913/xxxx")
# If purchase or lead labels are unset, they safely fall back to the primary tag label.
VITE_ADS_LABEL_PURCHASE=
VITE_ADS_LABEL_LEAD=
VITE_ADS_LABEL_CALL=

# Optional Google Analytics 4 Measurement ID (Format: "G-XXXXXXXXXX")
VITE_GA4_ID=

# Optional WhatsApp Contact Number (digits only, e.g. 19452879865)
# If unset, the WhatsApp button is omitted from the UI.
VITE_WHATSAPP_NUMBER=
